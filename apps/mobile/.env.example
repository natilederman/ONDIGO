EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-the-anon-key-printed-by-supabase-start

# Note: 127.0.0.1 only works from the iOS Simulator (it shares the host's localhost).
# For a physical device or Android emulator, use your machine's LAN IP instead,
# e.g. http://192.168.1.23:54321.
